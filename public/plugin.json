{
  "pluginName": "wordBook",
  "description": "慢记 - 艾宾浩斯遗忘曲线背单词/记忆训练工具：间隔重复到点复习，内置四六级、考研、雅思、托福、日语词库，背诗词古文、记公式长数字，支持 Anki 式卡片记忆、悬浮窗专注学习，电脑手机进度同步",
  "version": "1.3.0",
  "main": "index.html",
  "preload": "preload/services.js",
  "logo": "logo.png",
  "development": {
    "main": "http://localhost:3000/"
  },
  "features": [
    {
      "code": "review",
      "explain": "进入单词列表",
      "cmds": [
        "review",
        "慢记"
      ]
    },
    {
      "code": "over",
      "explain": "添加单词/句子",
      "cmds": [
        {
          "type": "over",
          "label": "收进单词/句子库",
          "minLength": 1
        }
      ]
    },
    {
      "code": "huaci",
      "explain": "划词/划段添加",
      "cmds": [
        {
          "type": "over",
          "label": "划词添加",
          "minLength": 1
        },
        "划词添加"
      ]
    },
    {
      "code": "jietu",
      "explain": "截图添加",
      "cmds": [
        {
          "type": "over",
          "label": "截图添加",
          "minLength": 1
        },
        {
          "type": "img",
          "label": "截图添加"
        },
        "截图添加"
      ]
    },
    {
      "code": "translate",
      "explain": "快速翻译",
      "cmds": [
        {
          "type": "over",
          "label": "翻译",
          "minLength": 1
        },
        "翻译"
      ]
    },
    {
      "code": "textMemory",
      "explain": "文本记忆",
      "cmds": [
        "文本记忆"
      ]
    },
    {
      "code": "focusMode",
      "explain": "专注模式",
      "cmds": [
        "专注"
      ]
    },
    {
      "code": "numMemory",
      "explain": "数字记忆",
      "cmds": [
        {
          "type": "regex",
          "label": "数字记忆",
          "match": "/\\d/",
          "minLength": 1
        },
        "数字记忆"
      ]
    },
    {
      "code": "shortcutMemory",
      "explain": "快捷键记忆",
      "cmds": [
        "快捷键记忆"
      ]
    },
    {
      "code": "palace",
      "explain": "记忆宫殿",
      "cmds": [
        "记忆宫殿"
      ]
    },
    {
      "code": "knowledge",
      "explain": "知识库",
      "cmds": [
        "知识库"
      ]
    }
  ],
  "permissions": {
    "clipboard": true,
    "system": true,
    "nativeWindow": true
  },
  "$schema": "../node_modules/utools-api-types/resource/utools.schema.json"
}
