{
  "pluginName": "wordBook",
  "description": "慢记 SlowRecap - 本地优先的记忆训练工具：按艾宾浩斯遗忘曲线安排到点复习，内置 30+ 主题词表（考试/职场/口语/多语言/常识），支持诗词古文分段记忆、公式与长数字编码、卡片记忆、迷你悬浮窗，电脑手机进度同步",
  "version": "1.3.13",
  "main": "index.html",
  "preload": "preload/services.js",
  "logo": "logo.png",
  "development": {
    "main": "http://localhost:3000/"
  },
  "features": [
    {
      "code": "review",
      "explain": "进入单词列表",
      "cmds": [
        "review",
        "慢记"
      ]
    },
    {
      "code": "over",
      "explain": "加入复习列表",
      "cmds": [
        {
          "type": "over",
          "label": "加入复习列表",
          "minLength": 1
        }
      ]
    },
    {
      "code": "overSentence",
      "explain": "收藏句子",
      "cmds": [
        {
          "type": "over",
          "label": "收藏句子",
          "minLength": 1
        }
      ]
    },
    {
      "code": "huaci",
      "explain": "划词/划段添加",
      "cmds": [
        "划词添加"
      ]
    },
    {
      "code": "huaciTranslate",
      "explain": "划词翻译",
      "cmds": [
        "划词翻译"
      ]
    },
    {
      "code": "jietu",
      "explain": "截图添加",
      "cmds": [
        {
          "type": "img",
          "label": "截图添加"
        },
        "截图添加"
      ]
    },
    {
      "code": "jietuTranslate",
      "explain": "截图翻译",
      "cmds": [
        "截图翻译"
      ]
    },
    {
      "code": "translate",
      "explain": "快速翻译",
      "cmds": [
        {
          "type": "over",
          "label": "翻译",
          "minLength": 1
        },
        "翻译"
      ]
    },
    {
      "code": "textMemory",
      "explain": "文本记忆",
      "cmds": [
        "文本记忆"
      ]
    },
    {
      "code": "focusMode",
      "explain": "专注模式",
      "cmds": [
        "专注"
      ]
    },
    {
      "code": "numMemory",
      "explain": "数字记忆",
      "cmds": [
        {
          "type": "regex",
          "label": "数字记忆",
          "match": "/\\d/",
          "minLength": 1
        },
        "数字记忆"
      ]
    },
    {
      "code": "shortcutMemory",
      "explain": "快捷键记忆",
      "cmds": [
        "快捷键记忆"
      ]
    },
    {
      "code": "palace",
      "explain": "记忆宫殿",
      "cmds": [
        "记忆宫殿"
      ]
    },
    {
      "code": "knowledge",
      "explain": "知识库",
      "cmds": [
        "知识库"
      ]
    }
  ],
  "permissions": {
    "clipboard": true,
    "system": true,
    "nativeWindow": true
  }
}
