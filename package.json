{
  "name": "slowlyrecord",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:upx": "vite build && rm -rf /mnt/d/slowlyRecord-dist && cp -r dist /mnt/d/slowlyRecord-dist",
    "type-check": "vue-tsc --build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev:electron": "vite --config vite.config.electron.ts",
    "build:electron": "vite build --config vite.config.electron.ts",
    "preview:electron": "vite preview --config vite.config.electron.ts",
    "dev:web": "vite --config vite.config.web.ts",
    "build:web": "vite build --config vite.config.web.ts",
    "preview:web": "vite preview --config vite.config.web.ts",
    "pack:electron": "npm run build:electron && electron-builder --config electron-builder.yml",
    "pack:electron:dir": "npm run build:electron && electron-builder --config electron-builder.yml --dir",
    "dev:mp-weixin": "cd mobile && npm run dev:mp-weixin",
    "build:mp-weixin": "cd mobile && npm run build:mp-weixin",
    "dev:app": "cd mobile && npm run dev:app",
    "build:app-android": "cd mobile && npm run build:app-android",
    "build:app-ios": "cd mobile && npm run build:app-ios",
    "postinstall": "node -e \"if(process.env.ELECTRON_MIRROR){require('electron')}\""
  },
  "main": "dist-electron/main.js",
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.13.4",
    "crypto-js": "^4.2.0",
    "echarts": "^6.1.0",
    "element-plus": "2.11.3",
    "leaflet": "^1.9.4",
    "lodash.clonedeep": "^4.5.0",
    "pako": "^2.1.0",
    "pinia": "^3.0.1",
    "pinia-plugin-persistedstate": "^4.2.0",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node22": "^22.0.1",
    "@types/crypto-js": "^4.2.2",
    "@types/leaflet": "^1.9.12",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/node": "^22.14.0",
    "@types/pako": "^2.0.4",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitejs/plugin-vue-jsx": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.1.3",
    "mathjax-full": "^3.2.1",
    "npm-run-all2": "^7.0.2",
    "puppeteer": "^25.1.0",
    "sass": "^1.32.7",
    "typescript": "~5.8.0",
    "unplugin-vue-components": "^32.1.0",
    "utools-api-types": "^7.5.1",
    "vite": "^6.4.2",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vitest": "^4.1.4",
    "vue-tsc": "^2.2.8"
  }
}
