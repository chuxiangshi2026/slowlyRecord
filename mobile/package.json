{
  "name": "slowlyrecord-mobile",
  "version": "1.0.0",
  "description": "慢记移动端 - UniApp 跨平台应用",
  "scripts": {
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin --minify",
    "dev:mp-toutiao": "uni -p mp-toutiao",
    "build:mp-toutiao": "uni build -p mp-toutiao --minify",
    "dev:app": "uni -p app",
    "build:app-android": "UNI_APP_CODE_SPLITTING=1 uni build -p app --minify",
    "build:app-ios": "UNI_APP_CODE_SPLITTING=1 uni build -p app --minify",
    "dev:h5": "uni -p h5",
    "build:h5": "uni build -p h5 --minify"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-components": "3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-h5": "^3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-mp-toutiao": "3.0.0-alpha-5020620260914001",
    "pako": "^2.1.0",
    "pinia": "2.1.7",
    "pinia-plugin-persistedstate": "3.2.1",
    "vue": "3.4.38"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5020620260914001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020620260914001",
    "@types/node": "^22.14.0",
    "typescript": "~5.8.0",
    "vite": "5.2.8",
    "vue-tsc": "^2.2.8"
  }
}
